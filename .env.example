# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MASTER ADMIN AUTHENTICATION SECRETS (Set in AI Studio Secrets Panel)
# Only the admin with this email and password can log into the Admin Control Panel on the live domain.
ADMIN_EMAIL="dokandari.shop@gmail.com"
ADMIN_PASSWORD="SET_YOUR_ADMIN_PASSWORD_IN_SECRETS"

# DOKANDARI E-COMMERCE CONFIGURATION (Merchant & Courier APIs)
# bKash Merchant API Configuration
BKASH_MERCHANT_NUMBER="01712345678"
BKASH_APP_KEY="PLACEHOLDER_BKASH_APP_KEY"
BKASH_APP_SECRET="PLACEHOLDER_BKASH_APP_SECRET"

# Nagad Merchant API Configuration
NAGAD_MERCHANT_NUMBER="01912345678"
NAGAD_PUBLIC_KEY="PLACEHOLDER_NAGAD_PUBLIC_KEY"

# Logistics & Courier API Credentials (Steadfast / Pathao Live Booking)
STEADFAST_API_KEY="PLACEHOLDER_STEADFAST_API_KEY"
STEADFAST_SECRET_KEY="PLACEHOLDER_STEADFAST_SECRET_KEY"
PATHAO_CLIENT_ID="PLACEHOLDER_PATHAO_CLIENT_ID"
PATHAO_CLIENT_SECRET="PLACEHOLDER_PATHAO_CLIENT_SECRET"

# Multi-Pixel & Server-Side Conversion API (Meta, TikTok, YouTube/Google Tag)
FACEBOOK_PIXEL_ID=""
FACEBOOK_CAPI_TOKEN=""
TIKTOK_PIXEL_ID=""
YOUTUBE_TAG_ID=""
