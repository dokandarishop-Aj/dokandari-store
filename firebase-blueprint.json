{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "An e-commerce catalog product in the Dokandari store.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique product identifier."
        },
        "name": {
          "type": "string",
          "description": "Display name of the product."
        },
        "category": {
          "type": "string",
          "description": "Product category."
        },
        "price": {
          "type": "number",
          "description": "Selling price in Bangladeshi Taka (BDT)."
        },
        "originalPrice": {
          "type": "number",
          "description": "Original price before discount in BDT."
        },
        "description": {
          "type": "string",
          "description": "Full product description and material specifications."
        },
        "inStock": {
          "type": "boolean",
          "description": "Whether the product is currently in stock."
        },
        "rating": {
          "type": "number",
          "description": "Average review rating (1 to 5)."
        },
        "reviewCount": {
          "type": "number",
          "description": "Number of customer reviews."
        }
      },
      "required": ["id", "name", "category", "price", "inStock"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order in Dokandari store.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Dokandari order reference code."
        },
        "subtotal": {
          "type": "number",
          "description": "Subtotal before shipping in BDT."
        },
        "shippingCost": {
          "type": "number",
          "description": "Shipping fee in BDT."
        },
        "total": {
          "type": "number",
          "description": "Total order amount in BDT."
        },
        "paymentMethod": {
          "type": "string",
          "description": "Payment method: cod, bkash, nagad, or rocket."
        },
        "status": {
          "type": "string",
          "description": "Order processing status."
        },
        "userId": {
          "type": "string",
          "description": "UID of the registered customer if signed in, or null."
        }
      },
      "required": ["id", "subtotal", "shippingCost", "total", "paymentMethod", "status"]
    },
    "BusinessExpense": {
      "title": "BusinessExpense",
      "description": "Business expense entry for P&L and accounting.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique expense ID."
        },
        "date": {
          "type": "string",
          "description": "Expense date (YYYY-MM-DD)."
        },
        "category": {
          "type": "string",
          "description": "Expense category identifier."
        },
        "categoryLabel": {
          "type": "string",
          "description": "Bengali display label for the expense category."
        },
        "amount": {
          "type": "number",
          "description": "Expense amount in BDT."
        },
        "note": {
          "type": "string",
          "description": "Description or reference note."
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp."
        }
      },
      "required": ["id", "date", "category", "amount"]
    },
    "CourierReturn": {
      "title": "CourierReturn",
      "description": "Courier return record and quality inspection state.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique return ID."
        },
        "orderId": {
          "type": "string",
          "description": "Original order ID."
        },
        "productName": {
          "type": "string",
          "description": "Returned product name."
        },
        "quantity": {
          "type": "number",
          "description": "Returned quantity."
        },
        "returnCharge": {
          "type": "number",
          "description": "Courier return fee in BDT."
        },
        "productCondition": {
          "type": "string",
          "description": "Product condition: sellable or damaged."
        },
        "status": {
          "type": "string",
          "description": "Return workflow status."
        }
      },
      "required": ["id", "orderId", "productName", "quantity", "status"]
    },
    "InventoryMovement": {
      "title": "InventoryMovement",
      "description": "Audit log of automatic stock adjustments and damage write-offs.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique movement ID."
        },
        "productId": {
          "type": "string",
          "description": "Target product ID."
        },
        "type": {
          "type": "string",
          "description": "Movement type: return_restock, damage_write_off, manual_adjustment."
        },
        "quantity": {
          "type": "number",
          "description": "Quantity changed."
        }
      },
      "required": ["id", "productId", "type", "quantity"]
    },
    "User": {
      "title": "User",
      "description": "Customer profile and preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth user identifier."
        },
        "email": {
          "type": "string",
          "description": "Customer email address."
        },
        "displayName": {
          "type": "string",
          "description": "Full customer name."
        },
        "role": {
          "type": "string",
          "description": "User role: customer or admin."
        }
      },
      "required": ["uid", "email"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Store configuration, banners, content, and API credentials.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Setting key identifier."
        }
      },
      "required": ["id"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer feedback and ratings for a product.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Review unique identifier."
        },
        "productId": {
          "type": "string",
          "description": "Target product ID."
        },
        "userName": {
          "type": "string",
          "description": "Customer display name."
        },
        "rating": {
          "type": "number",
          "description": "Star rating 1 to 5."
        },
        "comment": {
          "type": "string",
          "description": "Customer review message."
        }
      },
      "required": ["id", "productId", "userName", "rating", "comment"]
    },
    "PurchaseRecord": {
      "title": "PurchaseRecord",
      "description": "Supplier purchase record and stock entry for Purchase Management (#17).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique purchase record ID."
        },
        "purchaseDate": {
          "type": "string",
          "description": "Purchase date (YYYY-MM-DD)."
        },
        "supplierName": {
          "type": "string",
          "description": "Supplier name."
        },
        "invoiceNumber": {
          "type": "string",
          "description": "Supplier invoice number."
        },
        "productId": {
          "type": "string",
          "description": "Catalog product ID."
        },
        "productName": {
          "type": "string",
          "description": "Purchased product name."
        },
        "purchaseQuantity": {
          "type": "number",
          "description": "Quantity purchased."
        },
        "unitPurchasePrice": {
          "type": "number",
          "description": "Unit purchase price in BDT."
        },
        "grandTotalPurchaseCost": {
          "type": "number",
          "description": "Grand total cost including transport and other expenses."
        },
        "paidAmount": {
          "type": "number",
          "description": "Paid amount in BDT."
        },
        "dueAmount": {
          "type": "number",
          "description": "Due amount in BDT."
        },
        "status": {
          "type": "string",
          "description": "Purchase status: confirmed, pending, or cancelled."
        }
      },
      "required": ["id", "purchaseDate", "supplierName", "invoiceNumber", "productName", "purchaseQuantity", "grandTotalPurchaseCost", "status"]
    },
    "CustomerUgcReview": {
      "title": "CustomerUgcReview",
      "description": "Customer uploaded UGC photo/video review submission with pending approval status.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique UGC review ID."
        },
        "customerName": {
          "type": "string",
          "description": "Customer name."
        },
        "productName": {
          "type": "string",
          "description": "Reviewed product name."
        },
        "testimonial": {
          "type": "string",
          "description": "Customer review text."
        },
        "status": {
          "type": "string",
          "description": "Approval status: pending, approved, or rejected."
        }
      },
      "required": ["id", "customerName", "productName", "testimonial"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Public store products catalog."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders and fulfillment records."
    },
    "/business_expenses/{expenseId}": {
      "schema": "BusinessExpense",
      "description": "Business expense records for P&L analytics."
    },
    "/courier_returns/{returnId}": {
      "schema": "CourierReturn",
      "description": "Courier return records and quality inspection status."
    },
    "/inventory_movements/{movementId}": {
      "schema": "InventoryMovement",
      "description": "Inventory movement and auto-stock adjustment logs."
    },
    "/purchases/{purchaseId}": {
      "schema": "PurchaseRecord",
      "description": "Supplier purchase entries and stock records."
    },
    "/ugc_reviews/{reviewId}": {
      "schema": "CustomerUgcReview",
      "description": "Customer uploaded UGC reviews pending approval."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and customer accounts."
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "Store settings, hero banners, and integration credentials."
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Verified customer reviews."
    }
  }
}

